algoritmo "AULA 5"
var
idade, nasc, ano: inteiro
inicio
      Escreva ("Em que ano estamos? ")
      Leia (ano)
      Escreva ("Em que ano voce nasceu? ")
      Leia (nasc)
      idade <- ano - nasc
      Escreva ("Em", ano, " você terá", idade, " anos")
Se (idade >= 18) entao
      Escreva (" e ja atingiu a maioridade!")
Fimse
fimalgoritmo