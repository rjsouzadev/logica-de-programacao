algoritmo "AULA 5"
var
   idade: inteiro
   nome: caracter
inicio
      Escreva ("Qual é seu nome? ")
      Leia (nome)
      Escreva ("Qual a sua idade: ")
      Leia (idade)
Se (idade >= 18) então
      Escreva ("Pode entrar, você tem a idade permitida!")
Senão
      Escreva ("Você ainda é de menor, sua entra foi barrada!")
FimSe
fimalgoritmo