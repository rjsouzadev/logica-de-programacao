algoritmo "Aula 7.1"
var
   contador: inteiro
inicio
   contador <- 10
   Enquanto (contador >= 0) faça
      EscrevaL (contador)
      contador <- contador - 1
   FimEnquanto
   EscrevaL ("Terminei de contar!")
   contador <- 0
   Enquanto (contador <= 10) faça
      EscrevaL (contador)
      contador <- contador + 1
   FimEnquanto
   EscrevaL ("Terminei de contar!")
fimalgoritmo