algoritmo "AULA PRÁTICA - 12.2"
var
   N1, N2, N3: caractere
Procedimento linha()
inicio
   Escreval("--------------------")
FimProcedimento
inicio
   Escreva ("Digite um nome: ")
   Leia (N1)
   linha()
   Escreva ("Digite um nome: ")
   Leia (N2)
   linha()
   Escreva ("Digite um nome: ")
   Leia (N3)
   linha()
fimalgoritmo